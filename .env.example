# Beispiel-Datei für SMTP / E-Mail Versand
# 1) Kopiere diese Datei nach .env
# 2) Ersetze nur den Wert für SMTP_PASSWORD mit deinem Gmail-App-Passwort
# 3) Danach kannst du die Variablen im Terminal oder in deiner Runtime laden

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=inkhelp24@gmail.com
SMTP_PASSWORD=DEIN_GMAIL_APP_PASSWORT_HIER_EINFUEGEN
EMAIL_TO=inkhelp24@gmail.com

# Beispiel für lokale Nutzung im Terminal:
# export SMTP_HOST=smtp.gmail.com
# export SMTP_PORT=465
# export SMTP_USER=inkhelp24@gmail.com
# export SMTP_PASSWORD='DEIN_GMAIL_APP_PASSWORT_HIER_EINFUEGEN'
# export EMAIL_TO=inkhelp24@gmail.com
